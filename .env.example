# ------------------------------------------------------------
# Base de datos PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adrenalina_extrema
# Opcional: SSL para proveedores gestionados (Supabase, Neon, Railway...)
# DATABASE_SSL=true

# ------------------------------------------------------------
# Administrador inicial (se crea/actualiza con `npm run db:seed`)
# Cambia esta contraseña antes de publicar el sitio.
# ------------------------------------------------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@adrenalinaextrema.co
ADMIN_PASSWORD=Adrenalina2026!

# ------------------------------------------------------------
# Sitio
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=+573000000000
# Ruta local donde se guardan las fotografías subidas.
# En producción monta este directorio como volumen persistente
# o conecta un almacenamiento S3-compatible (ver README).
UPLOAD_DIR=storage/uploads

# ------------------------------------------------------------
# Integraciones (opcionales; sin credenciales quedan desactivadas)
# ------------------------------------------------------------
# Wompi (pagos en línea) — https://docs.wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# Facturación electrónica (proveedor autorizado, p. ej. Factus)
# La app NO emite facturas DIAN por sí sola.
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_API_URL=

# SMTP para correos transaccionales (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------
# Base de datos MySQL / MariaDB (Hostinger)
# ------------------------------------------------------------
# En Hostinger usa 127.0.0.1 (no "localhost") y el nombre de usuario/base
# completos que aparecen en hPanel > Bases de datos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=carnalitos
DB_PASSWORD=
DB_NAME=carnalitos
# Opcional: cadena única (tiene prioridad si no defines DB_USER/DB_NAME)
# DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/base
# Opcional: límite de conexiones del pool (Hostinger comparte conexiones)
# DB_CONNECTION_LIMIT=5
# Opcional: SSL para proveedores externos
# DB_SSL=false

# ------------------------------------------------------------
# Administrador inicial (se crea/actualiza con `npm run db:seed`)
# Cambia esta contraseña antes de publicar el sitio.
# ------------------------------------------------------------
ADMIN_NAME=Administrador Carnalitos
ADMIN_EMAIL=carnalitosbarf@gmail.com
ADMIN_PASSWORD=Cami0510*

# ------------------------------------------------------------
# Sitio y Contacto
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=+573108338636
# En Hostinger usa una ruta absoluta fuera de hbuilds/public_html para que
# las imágenes no se borren en cada despliegue. Ejemplo:
# UPLOAD_DIR=/home/u123456789/domains/tudominio.com/storage/uploads
UPLOAD_DIR=storage/uploads

# ------------------------------------------------------------
# Notificaciones Automáticas por Correo (Nodemailer)
# Cuando un cliente compra, el servidor envía un correo con el detalle completo.
# Para Gmail: genera una "Contraseña de aplicación" (App Password) en
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=carnalitosbarf@gmail.com
SMTP_PASS=
EMAIL_USER=carnalitosbarf@gmail.com
EMAIL_PASS=

# ------------------------------------------------------------
# Notificaciones Automáticas por WhatsApp al Dueño (+573108338636)
# El servidor envía un mensaje estructurado automáticamente al realizarse una orden.
#
# Opción 1: CallMeBot (Gratis, rápido e instantáneo para WhatsApp personal)
# Instrucciones: Agrega a WhatsApp el número +34 623 78 64 49 (o +34 644 95 42 75)
# y envía el mensaje: "I allow callmebot to send me messages" para recibir tu API key.
# ------------------------------------------------------------
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=+573108338636

# Opción 2: Twilio WhatsApp API (Opcional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Opción 3: Gateway propio / Webhook (Evolution API, UltraMsg, Baileys) (Opcional)
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_GATEWAY_TOKEN=

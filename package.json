{
  "name": "carnalitos",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda en línea de snacks y comida saludable para mascotas, con panel administrativo de productos, pedidos y estadísticas.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "tunnel": "powershell -ExecutionPolicy Bypass -Command \"& '$HOME\\Downloads\\cloudflared-windows-amd64.exe' tunnel --url http://localhost:3000\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/setup-db.mjs --reset",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "test:notifications": "node scripts/test-notifications.mjs"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "mysql",
    "mariadb",
    "mascotas",
    "snacks",
    "tienda",
    "colombia"
  ],
  "author": "Carnalitos",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "framer-motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "next": "^16.2.11",
    "nodemailer": "^10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.18",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.22"
  }
}
